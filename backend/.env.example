# =============================================================
# MEZCLA BACKEND — Environment Variables
# =============================================================
# Copy this to .env and fill in real values.
# NEVER commit .env to git. Only .env.example goes to GitHub.
# =============================================================

# ─── APP ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,https://mezclakitchen.in,https://admin.mezclakitchen.in

# ─── SUPABASE ─────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# anon/public key — safe to use in client-facing contexts
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# service_role key — ONLY in backend, NEVER in frontend/admin bundles
# Grants full DB access bypassing RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── AUTH ────────────────────────────────────────────────────
# Supabase JWT secret — found in Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-dashboard

# Admin email whitelist (comma-separated)
ADMIN_ALLOWED_EMAILS=admin@mezclakitchen.in

# ─── WAHA / WHATSAPP ─────────────────────────────────────────
# URL of your WAHA instance (VPS or Docker on server)
WAHA_BASE_URL=https://waha.mezclakitchen.in

# API key set in your WAHA .env (WAHA_API_KEY)
WAHA_API_KEY=your-waha-api-key-here

# WAHA session name (usually "default")
WAHA_SESSION=default

# Secret for verifying incoming WAHA webhook events
WAHA_WEBHOOK_SECRET=your-super-secret-webhook-key-here

# Your WhatsApp Business number in E.164 without "+"
# e.g. Indian number: 919876543210
BUSINESS_WHATSAPP_NUMBER=919999999999

# ─── SUPABASE STORAGE ────────────────────────────────────────
# Storage bucket name (create in Supabase dashboard)
STORAGE_BUCKET=mezcla

# ─── GOOGLE PLACES API (Reviews) ─────────────────────────────
# Places API (New) enabled in Google Cloud Console
GOOGLE_API_KEY=AIzaSy...
GOOGLE_PLACE_ID=ChIJ...

# ─── BUSINESS INFO (for PDF invoices) ────────────────────────
BUSINESS_NAME=Mezcla — The Artisanal Kitchen
BUSINESS_ADDRESS=Studio Kitchen, Bangalore, Karnataka 560001
BUSINESS_PHONE=+91-99999-99999
BUSINESS_EMAIL=hello@mezclakitchen.in
BUSINESS_FSSAI=12345678901234
BUSINESS_GSTIN=29AAAAA0000A1Z5
GST_CGST_PERCENT=2.5
GST_SGST_PERCENT=2.5

# ─── RATE LIMITING ───────────────────────────────────────────
# Max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── CRON JOBS ───────────────────────────────────────────────
# WhatsApp invoice retry cron (every 30 min)
CRON_WA_RETRY=*/30 * * * *

# ─── LOGGING ─────────────────────────────────────────────────
LOG_LEVEL=info
